# Secrets — never commit. FACEMARK_SECRET lives here locally; in production it
# is set through the platform's environment variable UI.
.env

# Byte-code
__pycache__/
*.py[cod]

# Local database. The image excludes it via .dockerignore too, so production
# always builds the schema from empty via db.init_db().
facemark.db
*.db-journal
*.db-wal

# Enrolment crops / snapshots — user data, regenerated at runtime
static/faces/*
static/profiles/*
static/visitors/*
static/ppe/*

# Virtualenvs and logs
.venv/
venv/
*.log
