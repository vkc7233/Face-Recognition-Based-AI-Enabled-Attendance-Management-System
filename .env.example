# FaceMark — environment variables.
# Copy to .env and edit; do NOT commit the real .env.

# ─── Core ───────────────────────────────────────────────────────────────
# Master secret used to derive encryption keys and sign sessions.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FACEMARK_SECRET=change-me-in-production

# Force secure cookies + HSTS (set 1 in production behind TLS)
FACEMARK_FORCE_HTTPS=0

# Asset version (busts /static cache). Bump on every release.
FACEMARK_ASSET_VERSION=v1

# ─── Production server (gunicorn.conf.py) ──────────────────────────────
FACEMARK_BIND=0.0.0.0:8000
FACEMARK_WORKERS=
FACEMARK_THREADS=4
FACEMARK_TIMEOUT=60
FACEMARK_LOG=info

# ─── Optional — provided by Settings UI in normal use ─────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
